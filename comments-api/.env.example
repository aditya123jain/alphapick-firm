# Copy to .env for local development. Never commit real values.
PORT=8787
# Any Postgres. Free option: a Neon free database, e.g.
#   postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# On a Render paid Postgres use its *internal* URL (no TLS needed).
DATABASE_URL=postgres://user:password@localhost:5432/comments
# Set to "require" to force TLS when DATABASE_URL has no sslmode parameter.
PGSSLMODE=
# Long random string. Sent as "Authorization: Bearer <token>" to the /v1/admin endpoints.
ADMIN_TOKEN=change-me
# Long random string used to hash IP addresses and voter tokens (raw IPs are never stored).
IP_HASH_SALT=change-me-too
# Comma-separated list of browser origins allowed to call the API. http://localhost:* and http://127.0.0.1:* are always allowed.
ALLOWED_ORIGINS=https://alphapick.in,https://www.alphapick.in
# Comma-separated study slugs that accept comments. Must match lib/knowledge.ts.
ALLOWED_SLUGS=three-lower-closes
